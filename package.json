{
  "name": "dsh-context-zoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context management strategies from coding agents, adapted as DSH plugins.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm test && node scripts/check-packages.mjs",
    "compare": "pnpm build && node examples/compare-budgets.mjs",
    "clean": "node scripts/clean.mjs",
    "test:profiles": "node --test scripts/check-dsh-profiles.mjs",
    "test:deepseek": "node scripts/check-deepseek.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-command-compact": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.2",
    "@types/node": "^22.20.0",
    "dsh-context-claude-code": "workspace:*",
    "dsh-context-codex": "workspace:*",
    "dsh-context-kimi-code": "workspace:*",
    "dsh-context-opencode": "workspace:*",
    "dsh-context-pi": "workspace:*",
    "dsh-context-qwen-code": "workspace:*",
    "dsh-context-zcode": "workspace:*",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1"
  }
}
