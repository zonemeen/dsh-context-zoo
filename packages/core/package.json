{
  "name": "dsh-context-core",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "DSH host primitives and durable context transactions for independent agent pipelines.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonemeen/dsh-context-zoo.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./compat/*": "./dist/compat/*"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md",
    "README.zh-CN.md",
    "src",
    "LICENSE",
    "dist/tools",
    "dist/compat"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2"
  },
  "homepage": "https://github.com/zonemeen/dsh-context-zoo/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/zonemeen/dsh-context-zoo/issues"
  },
  "bin": {
    "dsh-context-patch": "./dist/tools/create-profile-patch.mjs"
  }
}
